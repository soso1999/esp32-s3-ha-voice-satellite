# Copy to secrets.yaml locally; never publish populated secrets.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
# Required only by voice-satellite-secure.yaml. Replace both placeholders.
# Generate an API key locally: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_YOUR_32_BYTE_BASE64_KEY"
# Generate a unique OTA password locally: openssl rand -hex 24
ota_password: "REPLACE_WITH_YOUR_UNIQUE_OTA_PASSWORD"
